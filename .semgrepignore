# Ce fichier remplace la liste d'exclusion par défaut de Semgrep : on la reprend ici,
# puis on ajoute les exclusions propres au repo.
:include .gitignore

# Exclusions par défaut de Semgrep
node_modules/
build/
dist/
vendor/
.env/
.venv/
.tox/
*.min.js
.npm/
.yarn/
.semgrep/
.semgrep_logs/

# Lockfiles : plusieurs centaines de Ko de YAML généré, sans code à auditer.
# Les protections supply chain exigées par Semgrep sont dans pnpm-workspace.yaml et .npmrc, qui restent scannés.
pnpm-lock.yaml

# Code généré
apps/backend/src/generated/
