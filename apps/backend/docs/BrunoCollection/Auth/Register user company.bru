meta {
  name: Signup user company
  type: http
  seq: 5
}

post {
  url: http://localhost:3000/auth/signup
  body: json
  auth: none
}

headers {
  Origin: http://localhost:3000
}

body:json {
  {
    "email": "company.dev@opencarbon.com",
    "password": "Test123@",
    "role": "COMPANY"
  }
}

script:post-response {
  if (res.body && res.body.data && res.body.data.access_token) {
    bru.setVar("token", res.body.data.access_token);
  }
}
